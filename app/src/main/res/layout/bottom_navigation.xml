<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.bottomnavigation.BottomNavigationView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavigationView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@color/yt_background_primary"
    app:menu="@menu/bottom_navigation"
    app:itemIconTint="@color/bottom_nav_icon_tint"
    app:itemTextColor="@color/bottom_nav_text_tint"
    app:itemRippleColor="@color/yt_ripple"
    app:labelVisibilityMode="labeled"
    app:itemIconSize="24dp"
    app:itemTextAppearanceActive="@style/BottomNavTextActive"
    app:itemTextAppearanceInactive="@style/BottomNavTextInactive" />